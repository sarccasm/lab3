@model Product
<div asp-validation-summary="ModelOnly" class="danger"></div>
<label asp-for="Name"></label><input asp-for="Name" /><span asp-validation-for="Name" class="danger"></span>
<label asp-for="Category"></label><input asp-for="Category" /><span asp-validation-for="Category" class="danger"></span>
<label asp-for="Price"></label><input asp-for="Price" type="number" step="0.01" min="0" /><span asp-validation-for="Price" class="danger"></span>
<label asp-for="Description"></label><textarea asp-for="Description" rows="4"></textarea><span asp-validation-for="Description" class="danger"></span>
