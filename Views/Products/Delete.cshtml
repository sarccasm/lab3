@model Product
@{ ViewData["Title"] = "Delete product"; }
<h1>Delete product</h1><div class="panel"><p>Are you sure you want to delete <strong>@Model.Name</strong>?</p><form method="post" action="/products/delete/@Model.Id"><button class="delete" type="submit">Yes, delete</button><a class="btn secondary" href="/products">Cancel</a></form></div>
