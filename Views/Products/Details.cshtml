@model Product
@{ ViewData["Title"] = "Product details"; }
<h1>@Model.Name</h1><section class="panel"><p><strong>ID:</strong> @Model.Id</p><p><strong>Category:</strong> @Model.Category</p><p><strong>Price:</strong> @Model.Price.ToString("0.00")</p><p><strong>Description:</strong> @Model.Description</p><div class="buttons"><a class="btn" href="/products/edit/@Model.Id">Edit</a><a class="btn secondary" href="/products">All products</a></div></section>
